{
  "title": "AI-GCE Data",
  "description": "Per-project data shape for AI-GCE (Governance & Compliance Engine).",
  "type": "object",
  "required": ["$schemaVersion","$generatedBy","$generatedOn","$family","$package","data"],
  "properties": {
    "$schema":{"type":"string"},
    "$schemaVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "$generatedBy":{"type":"string","const":"AI-DFE"},
    "$generatedOn":{"type":"string","format":"date-time"},
    "$family":{"type":"string"},
    "$package":{"type":"string","const":"ai-gce"},
    "data":{
      "type":"object","required":["complianceTier"],
      "properties":{
        "projectName":{"type":["string","null"]},
        "currentPhase":{"type":["string","null"]},
        "complianceTier":{"type":["integer","null"]},
        "startDate":{"type":["string","null"]},
        "complianceScore":{"type":["number","null"]},
        "lastAudit":{"type":["string","null"]},
        "tierHistory":{"type":"array","items":{"type":"object","properties":{"tier":{"type":"integer"},"activatedDate":{"type":["string","null"]},"activatedBy":{"type":["string","null"]},"scoreAtActivation":{"type":["number","null"]}}}},
        "nextTierReadiness":{"type":["object","null"],"properties":{"tier":{"type":["integer","null"]},"criteriaMetCount":{"type":["integer","null"]},"criteriaTotalCount":{"type":["integer","null"]},"blockers":{"type":"array","items":{"type":"string"}}}},
        "dashboard":{"type":["object","null"],"properties":{"summary":{"type":["string","null"]},"scoreHistory":{"type":"array"}}},
        "activeAgentCount":{"type":["integer","null"]},
        "agents":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"agent":{"type":"string"},"type":{"type":["string","null"]},"trigger":{"type":["string","null"]},"tier":{"type":["integer","null"]},"status":{"type":["string","null"]}}}},
        "lastAuditScore":{"type":["number","null"]},
        "lastAuditRating":{"type":["string","null"]},
        "aiLens":{"type":["object","null"],"description":"AI-LENS fields (AI_LENS_PROTOCOL §6.2 — AI-GCE contract). Present when AIG__ agent has produced governance results.","properties":{
          "aiFeatures":{"type":"array","description":"Per-feature AI governance results from the AIG__ agent.","items":{"type":"object","properties":{
            "aiFeatureId":{"type":"string","description":"Stable thread identifier (AIF-{NNN})"},
            "aigResult":{"type":["string","null"],"description":"Overall governance result: pass | warning | fail"},
            "aigObligations":{"type":"array","items":{"type":"string"},"description":"EU AI Act and RAI obligations identified"},
            "aigFindings":{"type":"array","items":{"type":"object","properties":{"rule":{"type":"string"},"severity":{"type":"string"},"detail":{"type":"string"}}},"description":"Individual governance findings"}
          }}}
        }},
        "automationLens":{"type":["object","null"],"description":"Automation-LENS fields (AUTOMATION_LENS_PROTOCOL §6.2 — AI-GCE contract). Present when ATG__ agent has produced governance results.","properties":{
          "automationFeatures":{"type":"array","description":"Per-feature automation governance results from the ATG__ agent.","items":{"type":"object","properties":{
            "automationFeatureId":{"type":"string","description":"Stable thread identifier (AUTO-{NNN})"},
            "atgResult":{"type":["string","null"],"description":"Overall governance result: pass | warning | fail"},
            "atgObligations":{"type":"array","items":{"type":"string"},"description":"Audit, SoD, kill-switch, fail-safe, and control-class obligations identified"},
            "atgFindings":{"type":"array","items":{"type":"object","properties":{"rule":{"type":"string"},"severity":{"type":"string"},"detail":{"type":"string"}}},"description":"Individual automation governance findings"}
          }}}
        }}
      }
    }
  }
}